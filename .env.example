# Supabase Client Configuration (Vite & SSR)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_PROJECT_REF=your-project-ref

# Supabase Server Configuration (Admin/Secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase MCP Server Endpoint
SUPABASE_MCP_URL=https://mcp.supabase.com/mcp?project_ref=your-project-ref&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching

OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Cron "Vérifier → Remesure" (plan automatisation §4.1)
# Secret partagé attendu dans l'en-tête Authorization: Bearer <valeur> par
# POST /api/cron/site-check. À configurer aussi côté déclencheur externe
# (Render Cron Job, crontab, cron-job.org, GitHub Actions...).
CRON_SECRET=change-me-to-a-random-secret